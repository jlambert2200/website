---
import Base from './Base.astro';
import { formatDate, url } from '../lib/utils';

interface Props {
  title: string;
  date?: Date;
  summary?: string;
  meta?: string;
  backHref: string;
  backLabel: string;
}
const { title, date, summary, meta, backHref, backLabel } = Astro.props;
---

<Base title={title} description={summary}>
  <article class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-32 left-1/2 h-72 w-[48rem] -translate-x-1/2 rounded-full bg-linear-to-r from-teal-200/60 via-cyan-200/50 to-emerald-200/50 blur-3xl dark:from-teal-700/20 dark:via-cyan-700/15 dark:to-emerald-700/15"
    >
    </div>
    <div class="relative mx-auto max-w-2xl px-5 pt-14 pb-20">
      <a
        href={url(backHref)}
        class="text-sm font-medium text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
        >← {backLabel}</a
      >
      <header class="mt-6 mb-10">
        <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
          {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
          {
            meta && (
              <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                {meta}
              </span>
            )
          }
        </div>
        <h1 class="mt-3 font-serif text-5xl tracking-tight sm:text-6xl">{title}</h1>
        {summary && <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{summary}</p>}
      </header>
      <div
        class="prose prose-slate prose-lg max-w-none dark:prose-invert prose-a:text-teal-700 dark:prose-a:text-teal-300 prose-img:rounded-2xl"
      >
        <slot />
      </div>
    </div>
  </article>
</Base>
