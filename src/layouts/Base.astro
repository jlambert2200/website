---
import '../styles/global.css';
import { SITE } from '../site.config';
import { url } from '../lib/utils';

interface Props {
  title?: string;
  description?: string;
  // Header floats over a full-screen photo (used on the homepage)
  overlayHeader?: boolean;
}

const { title, description = SITE.tagline, overlayHeader = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;

const nav = [
  { label: 'Blog', href: '/blog/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Training', href: '/training/' },
  { label: 'CV', href: '/cv/' },
];

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const isActive = (href: string) => current.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('/rss.xml')} />
  </head>
  <body class="min-h-screen bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <header
      class:list={[
        'z-20',
        overlayHeader
          ? 'absolute inset-x-0 top-0 text-white'
          : 'sticky top-0 border-b border-slate-200/70 bg-white/70 backdrop-blur-lg dark:border-slate-800/70 dark:bg-slate-950/70',
      ]}
    >
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-5 py-3">
        <a href={url('/')} class="flex items-center gap-2 text-base font-semibold tracking-tight">
          <span
            aria-hidden="true"
            class="size-3 rounded-full bg-linear-to-br from-moss-500 to-moss-400 "
          ></span>
          {SITE.name}
        </a>
        <nav aria-label="Main" class="flex flex-wrap gap-1 text-sm">
          {
            nav.map((item) => (
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-3.5 py-2 font-medium transition-colors',
                  isActive(item.href)
                    ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900'
                    : overlayHeader
                      ? 'text-white/85 hover:bg-white/15 hover:text-white'
                      : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-800">
      <div
        class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-5 py-8 text-sm text-slate-500 dark:text-slate-400"
      >
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <div class="flex gap-5">
          {
            SITE.links.map((link) => (
              <a href={url(link.href)} class="hover:text-slate-900 dark:hover:text-white">
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </footer>
  </body>
</html>
