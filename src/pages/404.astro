---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/utils';
---

<Base title="Not found">
  <PageHeader title="Page not found" intro="That page doesn't exist, or it moved." />
  <div class="mx-auto max-w-5xl px-5 pb-24">
    <a href={url('/')} class="font-medium text-moss-700 hover:text-moss-900 dark:text-moss-300">← Back home</a>
  </div>
</Base>
