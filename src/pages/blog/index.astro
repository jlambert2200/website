---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostRow from '../../components/PostRow.astro';
import { url, byDateDesc } from '../../lib/utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDateDesc);
---

<Base title="Blog">
  <PageHeader title="Blog" intro="Thoughts, notes and whatever's on my mind." />
  <div class="mx-auto grid max-w-5xl gap-4 px-5 pb-24">
    {posts.map((p) => <PostRow href={url(`/blog/${p.id}/`)} title={p.data.title} date={p.data.date} summary={p.data.summary} />)}
  </div>
</Base>
