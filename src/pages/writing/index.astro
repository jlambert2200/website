---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostRow from '../../components/PostRow.astro';
import { url, byDateDesc } from '../../lib/utils';

const items = (await getCollection('writing', ({ data }) => !data.draft)).sort(byDateDesc);
---

<Base title="Writing">
  <PageHeader title="Writing" intro="Essays, papers and other things I've written." />
  {items.length === 0 && <p class="mx-auto max-w-5xl px-5 pb-24 text-slate-500 dark:text-slate-400">Nothing here yet.</p>}
  <div class="mx-auto grid max-w-5xl gap-4 px-5 pb-24 sm:grid-cols-2">
    {
      items.map((w) => (
        <PostRow
          href={w.data.file ? url(w.data.file) : url(`/writing/${w.id}/`)}
          external={!!w.data.file}
          title={w.data.title}
          date={w.data.date}
          meta={w.data.kind}
          summary={w.data.summary}
        />
      ))
    }
  </div>
</Base>
