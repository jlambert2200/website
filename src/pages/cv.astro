---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CvEntry from '../components/CvEntry.astro';
import { CV } from '../data/cv';

const sectionTitle = 'font-medium text-3xl tracking-tight sm:text-4xl';
---

<Base title="CV" description="CV of Jensen Lambert: technology research, intelligence, and international trade.">
  <PageHeader title="CV" intro={CV.profile} />

  <div class="mx-auto max-w-5xl px-5 pb-24">
    <div class="mb-14 flex flex-wrap items-center gap-3 text-sm">
      <a
        href={CV.linkedin}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-slate-900 px-5 py-2.5 font-semibold text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
        >LinkedIn ↗</a
      >
      <span class="rounded-full border border-slate-200 px-4 py-2.5 text-slate-600 dark:border-slate-700 dark:text-slate-300"
        >Languages: {CV.languages}</span
      >
    </div>

    <section class="mb-16">
      <h2 class={`${sectionTitle} mb-4`}>Experience</h2>
      {CV.experience.map((e) => <CvEntry {...e} />)}
    </section>

    <section class="mb-16">
      <h2 class={`${sectionTitle} mb-4`}>Education</h2>
      {CV.education.map((e) => <CvEntry {...e} />)}
    </section>

    <section class="mb-16">
      <h2 class={`${sectionTitle} mb-6`}>Skills</h2>
      <ul class="flex flex-wrap gap-2">
        {
          CV.skills.map((s) => (
            <li class="rounded-full bg-moss-50 px-3.5 py-1.5 text-sm font-medium text-moss-900 dark:bg-moss-950 dark:text-moss-100">
              {s}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-16">
      <h2 class={`${sectionTitle} mb-4`}>Leadership &amp; Service</h2>
      {CV.service.map((e) => <CvEntry {...e} />)}
    </section>

    <section>
      <h2 class={`${sectionTitle} mb-4`}>Articles &amp; Work Samples</h2>
      {
        CV.samples.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener"
            class="group grid gap-x-10 gap-y-1 border-t border-slate-200 py-5 md:grid-cols-[11rem_1fr] dark:border-slate-800"
          >
            <span class="text-sm text-slate-500 tabular-nums dark:text-slate-400">{s.date}</span>
            <span>
              <span class="font-semibold group-hover:text-moss-700 dark:group-hover:text-moss-300">{s.title}</span>
              <span class="text-slate-500 dark:text-slate-400"> · {s.where} ↗</span>
            </span>
          </a>
        ))
      }
    </section>
  </div>
</Base>
