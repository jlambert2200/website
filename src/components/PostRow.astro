---
import { formatDate } from '../lib/utils';

interface Props {
  href: string;
  title: string;
  date?: Date;
  summary?: string;
  meta?: string;
  external?: boolean;
}
const { href, title, date, summary, meta, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  class="group block rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-moss-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-moss-700"
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
    {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
    {
      meta && (
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
          {meta}
        </span>
      )
    }
  </div>
  <h3 class="mt-2 text-lg font-semibold tracking-tight group-hover:text-moss-700 dark:group-hover:text-moss-300">
    {title}{external && <span aria-hidden="true"> ↗</span>}
  </h3>
  {summary && <p class="mt-1.5 text-slate-600 dark:text-slate-400">{summary}</p>}
</a>
