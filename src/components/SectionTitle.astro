---
import { url } from '../lib/utils';

interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel = 'See all' } = Astro.props;
---

<div class="mb-6 flex items-end justify-between gap-4">
  <h2 class="font-medium text-3xl tracking-tight sm:text-4xl">{title}</h2>
  {
    href && (
      <a
        href={url(href)}
        class="text-sm font-medium text-moss-700 hover:text-moss-900 dark:text-moss-300 dark:hover:text-moss-200"
      >
        {linkLabel} →
      </a>
    )
  }
</div>
